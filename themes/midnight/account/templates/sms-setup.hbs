{{#if error}}
<div class="auth-error">{{error}}</div>
{{/if}}

{{#if info}}
<div class="auth-success">{{info}}</div>
{{/if}}

<h2 class="auth-subtitle">{{msg "smsSetupTitle"}}</h2>

{{#if activated}}
<div class="auth-success" style="margin-bottom: 1rem;">{{msg "smsSetupActivated"}}</div>
{{#if recoveryCodes}}
<div style="background: rgba(234,179,8,0.1); border: 1px solid rgba(234,179,8,0.2); border-radius: 14px; padding: 1rem; margin-bottom: 1rem;">
  <p style="font-weight: 600; color: #fde047; margin-bottom: 0.5rem;">{{msg "totpSetupSaveRecovery"}}</p>
  <p style="font-size: 0.8rem; color: #fde047; opacity: 0.8; margin-bottom: 0.75rem;">
    {{msg "smsSetupRecoveryHelp"}}
  </p>
  <div style="background: rgba(255,255,255,0.05); border-radius: 10px; padding: 0.75rem; font-family: monospace; font-size: 0.9rem; column-count: 2; column-gap: 1rem; color: #e2e8f0;">
    {{#each recoveryCodes}}
    <div style="margin-bottom: 0.25rem;">{{this}}</div>
    {{/each}}
  </div>
</div>
{{/if}}
{{#if continueAction}}
<form method="POST" action="{{continueAction}}" class="auth-form">
  <input type="hidden" name="_csrf" value="{{csrfToken}}">
  <button type="submit" class="btn-primary">{{msg "totpSetupDone"}}</button>
</form>
{{else}}
<a href="/realms/{{realmName}}/account" class="btn-primary" style="display: block; text-align: center; text-decoration: none;">{{msg "totpSetupDone"}}</a>
{{/if}}

{{else}}
{{#if verifyStep}}
<p style="color: #64748b; font-size: 0.85rem; margin-bottom: 1rem; text-align: center;">
  {{msgArgs "smsSetupEnterCode" maskedPhone}}
</p>

<form method="POST" action="/realms/{{realmName}}/account/sms-setup/verify" class="auth-form">
  <input type="hidden" name="_csrf" value="{{csrfToken}}">
  <div class="form-group">
    <label for="code">{{msg "smsCodeLabel"}}</label>
    <input type="text" id="code" name="code" pattern="[0-9]{6,10}" maxlength="10" inputmode="numeric" autocomplete="one-time-code" required autofocus
      style="text-align: center; font-size: 1.5rem; letter-spacing: 0.5rem;">
  </div>
  <button type="submit" class="btn-primary">{{msg "totpSetupVerifyActivate"}}</button>
</form>

<form method="POST" action="/realms/{{realmName}}/account/sms-setup/send" style="margin-top: 0.75rem; text-align: center;">
  <input type="hidden" name="_csrf" value="{{csrfToken}}">
  <input type="hidden" name="resend" value="1">
  <button type="submit" style="color: #06b6d4; background: none; border: none; cursor: pointer; font-size: 0.85rem; text-decoration: underline;">
    {{msg "smsSendNewCode"}}
  </button>
</form>
<p style="margin-top: 0.5rem; text-align: center; font-size: 0.8rem; color: #64748b;">{{msg "smsSetupWrongNumber"}}</p>
{{/if}}

{{#unless verifyStep}}
{{#if currentPhone}}
<p style="color: #64748b; font-size: 0.85rem; margin-bottom: 1rem; text-align: center;">
  {{msgArgs "smsSetupCurrent" currentPhone}}
</p>
{{/if}}
<p style="color: #64748b; font-size: 0.85rem; margin-bottom: 1rem; text-align: center;">
  {{msg "smsSetupInstruction"}}
</p>
{{/unless}}

<form method="POST" action="/realms/{{realmName}}/account/sms-setup/send" class="auth-form"{{#if verifyStep}} style="margin-top: 1rem;"{{/if}}>
  <input type="hidden" name="_csrf" value="{{csrfToken}}">
  <div class="form-group">
    <label for="phone">{{msg "smsSetupPhoneLabel"}}</label>
    <input type="tel" id="phone" name="phone" required autocomplete="tel" inputmode="tel" placeholder="+201012345678"{{#unless verifyStep}} autofocus{{/unless}}>
  </div>
  {{#if requirePassword}}
  <div class="form-group">
    <label for="currentPassword">{{msg "accountCurrentPassword"}}</label>
    <input type="password" id="currentPassword" name="currentPassword" required autocomplete="current-password">
  </div>
  {{/if}}
  <button type="submit" class="{{#if verifyStep}}btn-secondary{{else}}btn-primary{{/if}}">{{msg "smsSendCode"}}</button>
</form>

<div style="margin-top: 1rem; text-align: center;">
  <a href="{{totpSetupUrl}}" style="color: #06b6d4; font-size: 0.85rem;">{{msg "smsSetupUseAuthenticator"}}</a>
</div>
<div style="margin-top: 0.5rem; text-align: center;">
  <a href="{{cancelUrl}}" style="color: #64748b; font-size: 0.85rem;">{{msg "totpSetupCancel"}}</a>
</div>
{{/if}}
