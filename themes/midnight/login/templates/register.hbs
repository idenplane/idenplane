{{#if info}}
<div class="auth-success">{{info}}</div>
{{/if}}

{{#if error}}
<div class="auth-error">{{error}}</div>
{{/if}}

<form method="POST" action="/realms/{{realmName}}/register" class="auth-form" id="register-form"{{#if captcha}} data-captcha-provider="{{captcha.provider}}" data-captcha-site-key="{{captcha.siteKey}}" data-captcha-error="{{msg "captchaUnavailable"}}" data-captcha-incomplete="{{msg "captchaIncomplete"}}"{{/if}}>
  <input type="hidden" name="_csrf" value="{{csrfToken}}">
  <input type="hidden" name="client_id" value="{{client_id}}">
  <input type="hidden" name="redirect_uri" value="{{redirect_uri}}">
  <input type="hidden" name="response_type" value="{{response_type}}">
  <input type="hidden" name="scope" value="{{scope}}">
  <input type="hidden" name="state" value="{{state}}">
  <input type="hidden" name="nonce" value="{{nonce}}">
  <input type="hidden" name="code_challenge" value="{{code_challenge}}">
  <input type="hidden" name="code_challenge_method" value="{{code_challenge_method}}">
  <input type="hidden" name="prompt" value="{{prompt}}">
  {{#if acr_values}}<input type="hidden" name="acr_values" value="{{acr_values}}">{{/if}}
  {{#if claims}}<input type="hidden" name="claims" value="{{claims}}">{{/if}}

  <div class="form-group">
    <label for="username">{{msg "registerUsername"}}</label>
    <input type="text" id="username" name="username" required autocomplete="username" autofocus value="{{username}}" placeholder="{{msg "registerUsername"}}">
  </div>

  <div class="form-group">
    <label for="email">{{msg "registerEmail"}}</label>
    <input type="email" id="email" name="email" required autocomplete="email" value="{{email}}" placeholder="{{msg "registerEmail"}}">
  </div>

  <div class="auth-name-grid">
    <div class="form-group">
      <label for="firstName">{{msg "registerFirstName"}}</label>
      <input type="text" id="firstName" name="firstName" autocomplete="given-name" value="{{firstName}}" placeholder="{{msg "registerFirstName"}}">
    </div>

    <div class="form-group">
      <label for="lastName">{{msg "registerLastName"}}</label>
      <input type="text" id="lastName" name="lastName" autocomplete="family-name" value="{{lastName}}" placeholder="{{msg "registerLastName"}}">
    </div>
  </div>

  <div class="form-group">
    <label for="password">{{msg "registerPassword"}}</label>
    <input type="password" id="password" name="password" required autocomplete="new-password" minlength="{{passwordMinLength}}" placeholder="{{msg "registerPassword"}}">
    {{#if passwordHint}}
    <small class="auth-hint">{{passwordHint}}</small>
    {{/if}}
  </div>

  <div class="form-group">
    <label for="confirmPassword">{{msg "registerConfirmPassword"}}</label>
    <input type="password" id="confirmPassword" name="confirmPassword" required autocomplete="new-password" placeholder="{{msg "registerConfirmPassword"}}">
  </div>

  {{#if captcha}}
  <div class="form-group" id="captcha-container">
    {{#if captcha.isHcaptcha}}
    <div class="h-captcha" data-sitekey="{{captcha.siteKey}}" data-theme="dark"></div>
    {{/if}}
    {{#if captcha.isRecaptcha}}
    <input type="hidden" id="g-recaptcha-response" name="g-recaptcha-response" value="">
    <small class="auth-hint">{{msg "captchaRecaptchaNotice"}} <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer">{{msg "captchaPrivacy"}}</a> &middot; <a href="https://policies.google.com/terms" target="_blank" rel="noopener noreferrer">{{msg "captchaTerms"}}</a></small>
    {{/if}}
    <noscript><div class="auth-error">{{msg "captchaNoScript"}}</div></noscript>
  </div>
  {{/if}}

  <button type="submit" class="btn-primary">{{msg "registerCreateAccount"}}</button>
</form>

{{#if captcha}}
<script src="{{captcha.scriptUrl}}" async defer nonce="{{scriptNonce}}"></script>
<script nonce="{{scriptNonce}}">
  (function () {
    var form = document.getElementById('register-form');
    if (!form) return;
    var provider = form.getAttribute('data-captcha-provider');
    var siteKey = form.getAttribute('data-captcha-site-key');
    var pending = false;
    function showError(text) {
      var box = document.getElementById('captcha-error');
      if (!box) {
        box = document.createElement('div');
        box.id = 'captcha-error';
        box.className = 'auth-error';
        box.setAttribute('role', 'alert');
        document.getElementById('captcha-container').appendChild(box);
      }
      box.textContent = text;
    }
    form.addEventListener('submit', function (event) {
      if (provider === 'hcaptcha') {
        var answer = form.querySelector('[name="h-captcha-response"]');
        if (!answer || !answer.value) {
          event.preventDefault();
          showError(form.getAttribute('data-captcha-incomplete'));
        }
        return;
      }
      if (provider !== 'recaptcha') return;
      // reCAPTCHA v3: fetch a fresh token for this submission, then submit.
      event.preventDefault();
      if (pending) return;
      if (!window.grecaptcha || typeof window.grecaptcha.ready !== 'function') {
        showError(form.getAttribute('data-captcha-error'));
        return;
      }
      pending = true;
      window.grecaptcha.ready(function () {
        window.grecaptcha.execute(siteKey, { action: 'register' }).then(function (token) {
          document.getElementById('g-recaptcha-response').value = token;
          HTMLFormElement.prototype.submit.call(form);
        }, function () {
          pending = false;
          showError(form.getAttribute('data-captcha-error'));
        });
      });
    });
  })();
</script>
{{/if}}

<div class="auth-footer-link">
  <a href="/realms/{{realmName}}/login?client_id={{client_id}}&redirect_uri={{redirect_uri}}&response_type={{response_type}}&scope={{scope}}&state={{state}}&nonce={{nonce}}&code_challenge={{code_challenge}}&code_challenge_method={{code_challenge_method}}">{{msg "registerSignInPrompt"}}</a>
</div>
